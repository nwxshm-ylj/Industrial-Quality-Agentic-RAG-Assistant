# Copy this file to .env.production and replace every CHANGE_ME value.
# Never commit the real .env.production file.

ENVIRONMENT=production
API_PORT=18000

# PostgreSQL
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DB_PASSWORD
POSTGRES_DB=industrial_rag
DATABASE_URL=postgresql+psycopg2://rag_user:CHANGE_ME_URL_SAFE_DB_PASSWORD@postgres:5432/industrial_rag

# Qdrant: applications query the stable Alias, not the physical version name.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=industrial_docs_bge_m3_1024_v1
QDRANT_COLLECTION_ALIAS=industrial_docs_active

# Local BGE-M3 embedding. Pre-download and mount the pinned model revision.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-m3
LOCAL_EMBEDDING_MODEL_PATH=/app/data/models/bge-m3
LOCAL_EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
LOCAL_EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_BATCH_SIZE=8
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_NORMALIZE_EMBEDDINGS=true
# Optional Qwen fallback; it is not used when EMBEDDING_PROVIDER=local.
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024
QWEN_EMBEDDING_API_KEY=CHANGE_ME_QWEN_EMBEDDING_KEY
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_INDEX_VERSION=bge-m3-1024-v1

# Multimodal retrieval. Activate the Alias only after a non-empty index passes validation.
MULTIMODAL_ENABLED=true
MULTIMODAL_EMBEDDING_PROVIDER=qwen
QWEN_MULTIMODAL_EMBEDDING_MODEL=qwen3-vl-embedding
QWEN_MULTIMODAL_EMBEDDING_DIMENSION=1024
QWEN_MULTIMODAL_EMBEDDING_API_KEY=CHANGE_ME_MULTIMODAL_EMBEDDING_KEY
MULTIMODAL_EMBEDDING_INDEX_VERSION=qwen3vl-1024-v1
QDRANT_MULTIMODAL_COLLECTION=industrial_multimodal_qwen3vl_1024_v1
QDRANT_MULTIMODAL_COLLECTION_ALIAS=industrial_multimodal_active
MULTIMODAL_DEGRADED_MODE=text_only
DOTS_OCR_URL=
DOTS_OCR_TIMEOUT_SECONDS=120
DOCUMENT_CHUNK_SIZE=700
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_CHUNK_STRATEGY=layout_token_v2
DOCUMENT_CHUNK_TARGET_TOKENS=384
DOCUMENT_CHUNK_MAX_TOKENS=512
DOCUMENT_CHUNK_OVERLAP_TOKENS=48
DOCUMENT_PARSER_BACKEND=auto
DOCUMENT_PARSER_FALLBACK=native
DEEPDOC_ENABLED=false
DEEPDOC_RUNTIME_FACTORY=
DEEPDOC_RUNTIME_PORT=18010
DEEPDOC_RUNTIME_URL=http://deepdoc-runtime:8010
DEEPDOC_CONNECT_TIMEOUT_SECONDS=5
DEEPDOC_READ_TIMEOUT_SECONDS=300
DEEPDOC_HEALTH_TIMEOUT_SECONDS=2
DEEPDOC_MODEL_DIR=/app/data/models/deepdoc
DEEPDOC_REQUIRE_MODEL_FILES=true
DEEPDOC_ZOOMIN=3
DEEPDOC_MAX_PAGES=2000

# OpenSearch. Use HTTPS and credentials for a real production cluster.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=industrial_docs
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
KEYWORD_SEARCH_BACKEND=opensearch
HYBRID_DEGRADED_MODE=vector_only
RETRIEVAL_FUSION_STRATEGY=rrf
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_FAIL_OPEN=true

# Layered memory.
LAYERED_MEMORY_ENABLED=true
REDIS_URL=redis://redis:6379/0
MEMORY_SHORT_TERM_TTL_SECONDS=86400
MEMORY_SHORT_TERM_MAX_MESSAGES=20
MEMORY_SEMANTIC_SCORE_THRESHOLD=0.45
MEMORY_QDRANT_COLLECTION=industrial_memory_bge_m3_1024_v1
MEMORY_INDEX_VERSION=bge-m3-v1

# Neo4j quality-case graph.
KNOWLEDGE_GRAPH_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_GRAPH_PASSWORD
NEO4J_DATABASE=neo4j

# LLM
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# On-demand semantic RAG evaluation. This may call paid judge and embedding APIs.
RAGAS_ENABLED=true
RAGAS_VERSION=0.4.3
RAGAS_JUDGE_MODEL=qwen-plus
RAGAS_EMBEDDING_MODEL=text-embedding-v4
RAGAS_DATASET_PATH=data/eval/ragas_eval_questions.json

# Authentication. Generate a unique random secret of at least 32 characters.
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Prompt release
PROMPT_CATALOG_PATH=prompts/catalog
PROMPT_RELEASE_PATH=prompts/releases/stable.yaml
PROMPT_VALIDATE_ON_STARTUP=true
PROMPT_EXPOSE_VERSION_IN_RESPONSE=true

# Observability. Content capture should remain disabled unless approved.
TELEMETRY_ENABLED=true
METRICS_ENABLED=true
USAGE_ANALYTICS_ENABLED=true
TELEMETRY_CAPTURE_CONTENT=false
OTEL_SERVICE_NAME=industrial-quality-rag-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

REACT_WEB_PORT=30080
