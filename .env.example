QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=industrial_docs_qwen_1024_v1
QDRANT_COLLECTION_ALIAS=industrial_docs_active
LEGACY_QDRANT_COLLECTION=industrial_docs
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=qwen
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024
QWEN_EMBEDDING_API_KEY=your_api_key_here
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
QWEN_EMBEDDING_BATCH_SIZE=10
EMBEDDING_INDEX_VERSION=qwen-1024-v1

# Multimodal indexing is opt-in and uses a physically isolated Qdrant collection.
MULTIMODAL_ENABLED=false
MULTIMODAL_EMBEDDING_PROVIDER=qwen
QWEN_MULTIMODAL_EMBEDDING_MODEL=qwen3-vl-embedding
QWEN_MULTIMODAL_EMBEDDING_DIMENSION=1024
QWEN_MULTIMODAL_EMBEDDING_API_KEY=your_api_key_here
QWEN_MULTIMODAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
MULTIMODAL_EMBEDDING_INDEX_VERSION=qwen3vl-1024-v1
QDRANT_MULTIMODAL_COLLECTION=industrial_multimodal_qwen3vl_1024_v1
QDRANT_MULTIMODAL_COLLECTION_ALIAS=industrial_multimodal_active
MULTIMODAL_DEGRADED_MODE=text_only
DOTS_OCR_URL=
DOTS_OCR_TIMEOUT_SECONDS=120
DOCUMENT_CHUNK_SIZE=700
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_CHUNK_STRATEGY=layout_token_v2
DOCUMENT_CHUNK_TARGET_TOKENS=384
DOCUMENT_CHUNK_MAX_TOKENS=512
DOCUMENT_CHUNK_OVERLAP_TOKENS=48
DOCUMENT_PARSER_BACKEND=auto
DOCUMENT_PARSER_FALLBACK=native
DEEPDOC_ENABLED=false
DEEPDOC_RUNTIME_FACTORY=
DEEPDOC_RUNTIME_PORT=18010
DEEPDOC_RUNTIME_URL=http://localhost:18010
DEEPDOC_CONNECT_TIMEOUT_SECONDS=5
DEEPDOC_READ_TIMEOUT_SECONDS=300
DEEPDOC_HEALTH_TIMEOUT_SECONDS=2
DEEPDOC_MODEL_DIR=data/models/deepdoc
DEEPDOC_REQUIRE_MODEL_FILES=true
DEEPDOC_ZOOMIN=3
DEEPDOC_MAX_PAGES=2000

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=industrial_docs
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CONNECT_TIMEOUT=5
OPENSEARCH_READ_TIMEOUT=10
OPENSEARCH_POOL_MAXSIZE=20
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_RETRY_ON_TIMEOUT=true
KEYWORD_SEARCH_BACKEND=opensearch
KEYWORD_INDEX_VERSION=v1
HYBRID_DEGRADED_MODE=vector_only
RETRIEVAL_FUSION_STRATEGY=rrf
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_KEYWORD_WEIGHT=0.35

ENVIRONMENT=development
TELEMETRY_ENABLED=true
METRICS_ENABLED=true
USAGE_ANALYTICS_ENABLED=true
OTEL_SERVICE_NAME=industrial-quality-rag-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=5
TELEMETRY_CAPTURE_CONTENT=false
MODEL_PRICING_PATH=data/config/model_pricing.yaml
USAGE_RETENTION_DAYS=90
USAGE_BACKGROUND_WORKERS=4
USAGE_BACKGROUND_MAX_PENDING=1000

LLM_MODEL=qwen-plus
LLM_PROVIDER=qwen
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Prompt Catalog 与发布版本。生产环境应只切换经过评估的 Release Manifest。
PROMPT_CATALOG_PATH=prompts/catalog
PROMPT_RELEASE_PATH=prompts/releases/stable.yaml
PROMPT_VALIDATE_ON_STARTUP=true
PROMPT_EXPOSE_VERSION_IN_RESPONSE=true

# RAGAS is opt-in because it invokes paid judge/embedding APIs.
RAGAS_ENABLED=false
RAGAS_VERSION=0.4.3
RAGAS_JUDGE_MODEL=qwen-plus
RAGAS_EMBEDDING_MODEL=text-embedding-v4
RAGAS_DATASET_PATH=data/eval/ragas_eval_questions.json

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=industrial_rag
DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/industrial_rag

# Layered memory: PostgreSQL audit + Redis short-term + Qdrant/OpenSearch episodic.
LAYERED_MEMORY_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_READ_TIMEOUT_SECONDS=2
MEMORY_REDIS_KEY_PREFIX=industrial_rag:memory
MEMORY_SHORT_TERM_TTL_SECONDS=86400
MEMORY_SHORT_TERM_MAX_MESSAGES=20
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
MEMORY_RECENT_LIMIT=6
MEMORY_LONG_TERM_LIMIT=4
MEMORY_SEMANTIC_SCORE_THRESHOLD=0.45
MEMORY_KEYWORD_MIN_SCORE=0
MEMORY_QDRANT_COLLECTION=industrial_memory_qwen_1024_v1
MEMORY_INDEX_VERSION=v1
MEMORY_BACKGROUND_WORKERS=2
MEMORY_BACKGROUND_MAX_PENDING=100

# Optional knowledge graph augmentation for historical case search.
KNOWLEDGE_GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_graph_password
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_MAX_CONNECTION_POOL_SIZE=20
KNOWLEDGE_GRAPH_RESULT_LIMIT=5

RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=false
RERANKER_FAIL_OPEN=true

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
PROMETHEUS_RETENTION=15d

# React Nginx 宿主端口。Windows 可能保留 3000，默认使用 30080。
REACT_WEB_PORT=30080
